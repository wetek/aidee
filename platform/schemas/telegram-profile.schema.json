{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidee:schema:telegram-profile:1",
  "title": "Aidee Telegram Bot Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "short_description",
    "description",
    "commands",
    "avatar_path",
    "menu_button"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "short_description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "commands": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "description"],
        "properties": {
          "command": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,32}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "avatar_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "menu_button": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "text", "url"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "url": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    }
  }
}
