{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidee:schema:assistant-request:1",
  "title": "Aidee Assistant Operation Request",
  "oneOf": [
    {
      "$ref": "#/$defs/buildImage"
    },
    {
      "$ref": "#/$defs/createAssistant"
    },
    {
      "$ref": "#/$defs/lifecycle"
    },
    {
      "$ref": "#/$defs/listAssistants"
    },
    {
      "$ref": "#/$defs/fleetOverview"
    },
    {
      "$ref": "#/$defs/setCredentials"
    },
    {
      "$ref": "#/$defs/setDashboardOrigin"
    },
    {
      "$ref": "#/$defs/setControllerLangfuse"
    },
    {
      "$ref": "#/$defs/setAssistantLangfuse"
    },
    {
      "$ref": "#/$defs/setControllerOpencode"
    },
    {
      "$ref": "#/$defs/setAssistantOpencode"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "owner_approved": {
          "const": true
        }
      },
      "required": ["schema_version", "request_id", "owner_approved"]
    },
    "buildImage": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "build_image"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation"
          ]
        }
      ]
    },
    "createAssistant": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "create_assistant"
            },
            "assistant": {
              "$ref": "#/$defs/assistant"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant"
          ]
        }
      ]
    },
    "lifecycle": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "enum": [
                "start_assistant",
                "stop_assistant",
                "status_assistant",
                "reveal_dashboard_password",
                "reset_dashboard_password"
              ]
            },
            "assistant_id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant_id"
          ]
        }
      ]
    },
    "listAssistants": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "list_assistants"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation"
          ]
        }
      ]
    },
    "fleetOverview": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "fleet_overview"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation"
          ]
        }
      ]
    },
    "setCredentials": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_dashboard_credentials"
            },
            "assistant_id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "dashboard_username": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
            },
            "dashboard_password": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128,
              "pattern": "^[^\\r\\n]+$"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant_id",
            "dashboard_username",
            "dashboard_password"
          ]
        }
      ]
    },
    "setDashboardOrigin": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_dashboard_origin"
            },
            "assistant_id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "dashboard_url": {
              "type": "string",
              "minLength": 12,
              "maxLength": 500,
              "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?/?$"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant_id",
            "dashboard_url"
          ]
        }
      ]
    },
    "langfuseKeys": {
      "type": "object",
      "properties": {
        "public_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "secret_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "base_url": {
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^https://[A-Za-z0-9.-]+(?::[0-9]{2,5})?(?:/[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=-]*)?$"
        }
      }
    },
    "setControllerLangfuse": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "$ref": "#/$defs/langfuseKeys"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_controller_langfuse"
            },
            "enabled": {
              "type": "boolean"
            },
            "public_key": {
              "type": "string"
            },
            "secret_key": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "enabled"
          ]
        }
      ]
    },
    "setAssistantLangfuse": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_assistant_langfuse"
            },
            "assistant_id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant_id"
          ]
        }
      ]
    },
    "setControllerOpencode": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_controller_opencode"
            },
            "action": {
              "enum": ["install", "uninstall"]
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "action"
          ]
        }
      ]
    },
    "setAssistantOpencode": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema_version": {
              "const": 1
            },
            "request_id": {
              "type": "string"
            },
            "owner_approved": {
              "const": true
            },
            "operation": {
              "const": "set_assistant_opencode"
            },
            "assistant_id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "action": {
              "enum": ["install", "uninstall"]
            }
          },
          "required": [
            "schema_version",
            "request_id",
            "owner_approved",
            "operation",
            "assistant_id",
            "action"
          ]
        }
      ]
    },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "purpose",
        "image_version",
        "model_provider",
        "telegram",
        "resources",
        "dashboard"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\r\\n]+$"
        },
        "kind": {
          "enum": ["personal", "coding", "client", "project"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]+$"
        },
        "image_version": {
          "$comment": "Validation pins const to the tag in LATEST.",
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"
        },
        "model_provider": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "telegram": {
          "type": "boolean"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_limit", "memory_mb", "pids_limit"],
          "properties": {
            "cpu_limit": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 8
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 32768
            },
            "pids_limit": {
              "type": "integer",
              "minimum": 64,
              "maximum": 2048
            }
          }
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_port", "tailscale_https_port"],
          "properties": {
            "host_port": {
              "type": "integer",
              "minimum": 9200,
              "maximum": 9299
            },
            "tailscale_https_port": {
              "type": "integer",
              "minimum": 8443,
              "maximum": 8499
            }
          }
        }
      }
    }
  }
}
