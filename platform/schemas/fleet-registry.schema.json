{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidee:schema:fleet-registry:1",
  "title": "Aidee Fleet Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "controller", "assistants"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "default_version"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "default_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "desired_release": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$"
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state_path"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "state_path": {"type": "string", "minLength": 1},
        "dashboard_hostname": {"type": ["string", "null"]},
        "telegram_username": {"type": ["string", "null"]}
      }
    },
    "assistants": {
      "type": "array",
      "items": {"$ref": "#/$defs/assistant"},
      "default": []
    }
  },
  "$defs": {
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "status",
        "platform_version",
        "state_path",
        "container_name",
        "resources",
        "image"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["personal", "coding", "client", "project"]},
        "status": {
          "enum": ["planned", "provisioning", "active", "failed", "stopped", "retired"]
        },
        "platform_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "state_path": {"type": "string", "minLength": 1},
        "container_name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostname": {"type": ["string", "null"]},
            "host_port": {
              "anyOf": [
                {"type": "integer", "minimum": 1024, "maximum": 65535},
                {"type": "null"}
              ]
            },
            "tailscale_https_port": {
              "anyOf": [
                {"type": "integer", "minimum": 8443, "maximum": 8499},
                {"type": "null"}
              ]
            },
            "url": {"type": ["string", "null"]}
          }
        },
        "telegram": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {"type": ["string", "null"]},
            "configured": {"type": "boolean"}
          }
        },
        "fleet_observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {"const": "langfuse"},
            "project_name": {"type": ["string", "null"]},
            "configured": {"type": "boolean"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_limit", "memory_mb", "storage_gb", "pids_limit"],
          "properties": {
            "cpu_limit": {"type": "number", "exclusiveMinimum": 0},
            "memory_mb": {"type": "integer", "minimum": 512},
            "storage_gb": {"type": "integer", "minimum": 1},
            "pids_limit": {"type": "integer", "minimum": 64}
          }
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aidee_version", "image_id"],
          "properties": {
            "aidee_version": {"type": "string", "minLength": 1},
            "image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "onboarding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "status_path"],
          "properties": {
            "status": {
              "enum": ["pending", "in_progress", "complete"]
            },
            "status_path": {
              "const": "aidee/onboarding-status.json"
            }
          }
        }
      }
    }
  }
}

