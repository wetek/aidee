+def _canonical_json_value(value: Any, depth: int = 0) -> Any:
+    """Normalize JSON-like schema data without using process-specific repr values."""
+    if depth > 32:
+        return {"invalid": "maximum_depth"}
+    if value is None or isinstance(value, (bool, int, str)):
+        return value
+    if isinstance(value, float):
+        return value if value == value and abs(value) != float("inf") else {"invalid": "nonfinite_float"}
+    if isinstance(value, (list, tuple)):
+        return [_canonical_json_value(item, depth + 1) for item in value]
+    if isinstance(value, dict):
+        return {
+            key: _canonical_json_value(value[key], depth + 1)
+            for key in sorted(item for item in value if isinstance(item, str))
+        }
+    return {"invalid_type": f"{type(value).__module__}.{type(value).__qualname__}"}
+
+
+def _json_sha256(value: Any) -> str:
+    canonical = json.dumps(
+        _canonical_json_value(value),
+        sort_keys=True,
+        separators=(",", ":"),
+        ensure_ascii=False,
+        allow_nan=False,
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
+
+def _tool_identity(tool: Any) -> dict:
+    """Return bounded digests of provider-visible fields, excluding runtime metadata."""
+    if not isinstance(tool, dict):
+        return {"invalid_type": type(tool).__qualname__}
+    function = tool.get("function")
+    if not isinstance(function, dict):
+        return {"type": tool.get("type") if isinstance(tool.get("type"), str) else ""}
+    return {
+        "type": tool.get("type") if isinstance(tool.get("type"), str) else "",
+        "name": function.get("name") if isinstance(function.get("name"), str) else "",
+        "description_sha256": _json_sha256(function.get("description", "")),
+        "parameters_sha256": _json_sha256(function.get("parameters", {})),
+    }
+
+
+def runtime_context_fingerprint(agent: Any, prompt: str) -> str:
+    """Hash effective prompt and runtime identity without persisting raw context."""
+    try:
+        cwd = str(resolve_agent_cwd())
+    except Exception:
+        cwd = ""
+    payload = {
+        "prompt": prompt,
+        "model": str(getattr(agent, "model", "") or ""),
+        "provider": str(getattr(agent, "provider", "") or ""),
+        "cwd": cwd,
+        "tools": sorted(
+            (_tool_identity(tool) for tool in (getattr(agent, "tools", None) or [])),
+            key=lambda item: (
+                item.get("name", ""),
+                json.dumps(item, sort_keys=True, separators=(",", ":"), ensure_ascii=False),
+            ),
+        ),
+        "enabled_toolsets": sorted(
+            value for value in (getattr(agent, "enabled_toolsets", None) or [])
+            if isinstance(value, str)
+        ),
+        "disabled_toolsets": sorted(
+            value for value in (getattr(agent, "disabled_toolsets", None) or [])
+            if isinstance(value, str)
+        ),
+    }
+    canonical = json.dumps(
+        payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False
+    )
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()
+
