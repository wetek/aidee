+    def update_runtime_context(
+        self, session_id: str, system_prompt: str, fingerprint: str,
+        tool_names: Optional[List[str]] = None, *, persist_tools: bool = False,
+    ) -> None:
+        """Atomically store a prompt, its fingerprint, and optionally its tool order."""
+        if not session_id:
+            return
+
+        def _do(conn):
+            merged = self._merge_model_config_json(
+                conn, session_id, {"_runtime_context_fingerprint": fingerprint}
+            )
+            if merged is _MODEL_CONFIG_ROW_MISSING:
+                return
+            if persist_tools:
+                conn.execute(
+                    """UPDATE sessions
+                       SET system_prompt_hash = ?, system_prompt = NULL,
+                           model_config = ?, tool_names = ?
+                       WHERE id = ?""",
+                    (
+                        self._store_system_prompt(conn, system_prompt),
+                        merged,
+                        json.dumps(list(tool_names or [])),
+                        session_id,
+                    ),
+                )
+            else:
+                conn.execute(
+                    """UPDATE sessions
+                       SET system_prompt_hash = ?, system_prompt = NULL,
+                           model_config = ?
+                       WHERE id = ?""",
+                    (
+                        self._store_system_prompt(conn, system_prompt),
+                        merged,
+                        session_id,
+                    ),
+                )
+            self._delete_unreferenced_system_prompts(conn)
+
+        self._execute_write(_do)
+
     def update_session_tool_names(self, session_id: str, tool_names: Optional[List[str]]) -> None:
