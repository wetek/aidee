{
  "schema_version": 1,
  "release": "v0.1.0-alpha.14",
  "owner": {
    "name": "Example Owner",
    "experience": "guided"
  },
  "server": {
    "provider": "google_cloud",
    "dashboard_access": "tailscale"
  },
  "controller": {
    "model_provider": "gemini",
    "messaging": [
      "telegram"
    ],
    "telegram": {
      "access": "pairing",
      "branding": "offer",
      "avatar": "generate_or_upload",
      "menu_button": true
    }
  },
  "fleet": {
    "assistants": [
      {
        "name": "Example Coding Assistant",
        "kind": "coding",
        "purpose": "Maintain one approved software project.",
        "coding_agent": "opencode",
        "repository": "https://github.com/example/project",
        "authority": "pull_request"
      }
    ]
  },
  "recovery": {
    "private_git": "later",
    "provider": null
  },
  "updates": {
    "daily_check": true
  }
}
